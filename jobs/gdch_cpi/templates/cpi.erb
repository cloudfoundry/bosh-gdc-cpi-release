#!/usr/bin/env bash

set -e

# set directories
PACKAGES_DIR=${BOSH_PACKAGES_DIR:-/var/vcap/packages}
JOBS_DIR=${BOSH_JOBS_DIR:-/var/vcap/jobs}
LOGS_DIR=${LOGS_DIR:-/var/vcap/sys/log/gdch_cpi}

# start CPI
platform=`uname | tr '[:upper:]' '[:lower:]'`
cpi_bin="${PACKAGES_DIR}/bosh-gdch-cpi/bin/cpi_${platform}"
cmd="${cpi_bin} -configPath=${JOBS_DIR}/gdch_cpi/config/cpi_config.json"

if [ -d ${LOGS_DIR} ]; then
  exec $cmd 2>>${LOGS_DIR}/cpi.stderr.log <&0
else
  exec $cmd <&0
fi
