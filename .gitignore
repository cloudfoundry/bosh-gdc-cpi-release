# Binaries and build artifacts
bin/
src/
.tools/
tmp/
.dev_builds/
dev_releases/
blobs/
.blobs/
*.tgz
*.tgz.sha256
vulnerability-report-*.md
# NOTE: releases/**/*.yml and .final_builds/ are committed on purpose: bosh.io rebuilds
# final releases from that metadata (blobs are served from GitHub Release assets, see
# config/final.yml). Only the built tarballs/reports next to them are ignored above.

# Test and coverage artifacts
coverage/
/cfbosh_coverage_report/
/gardener_coverage_report/
/testlist
e2e/gpctest/test/*-kubeconfig

# Backups and temporary files
*.orig
*.sw[pq]
.DS_Store

# Editor and IDE paraphernalia
.idea/
.vscode/

# Python bytecode cache
__pycache__/
*.pyc

# Ignore Terraform state files
*.tfvars
*.terraform/
*.terraform.lock.hcl
